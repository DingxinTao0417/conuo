    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "gsap": "3.15.0",
    "idb": "^8.0.3",
    "ipaddr.js": "2.5.0",
    "jsdom": "30.0.1",
    "jszip": "^3.10.1",
    "katex": "0.16.47",
    "lenis": "1.3.26",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.10.0",
    "next": "16.3.5",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
