{
  "name": "@conuo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare:assets",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run prepare:assets",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:retrieval": "vitest run eval/retrieval.eval.test.ts",
    "eval:model": "CONUO_EVAL_MODEL=1 vitest run eval/model.eval.test.ts",
    "format": "prettier --write src scripts *.json *.mjs *.ts",
    "format:check": "prettier --check src scripts *.json *.mjs *.ts"
  },
  "dependencies": {
