# Copy this file to apps/web/.env.local and use your Supabase project's values.
# NEXT_PUBLIC_* values enter the browser: use only a publishable (or legacy anon) key.
# Never put a secret or service_role key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional model service. Keep all CONUO_MODEL_* variables server-only.
# Leave all three connection values blank to keep evidence-extract mode.
# BASE_URL includes any provider API prefix, e.g. https://host.example/v1;
# the server appends /chat/completions. Use your chosen provider's real values.
CONUO_MODEL_BASE_URL=
CONUO_MODEL_API_KEY=
CONUO_MODEL_NAME=
# Explicit opt-in for PDF region screenshots. Keep false unless the selected
# model's current documentation confirms image input support. As of 2026-09-14,
# DeepSeek deepseek-flash supports image input; its region study still requires
# this flag to be true.
CONUO_MODEL_VISION_ENABLED=false
# Only enable when the chosen model supports response_format: json_object.
CONUO_MODEL_JSON_MODE=false
# The documented output-limit field. Most OpenAI-compatible providers use
# max_completion_tokens; DeepSeek Chat Completions currently uses max_tokens.
CONUO_MODEL_TOKEN_LIMIT_PARAMETER=max_completion_tokens
# Optional provider-specific thinking switch: enabled or disabled; empty omits it.
# Set only when the provider supports thinking: {type: ...}. DeepSeek defaults
# to thinking enabled; disabled keeps the structured final answer within the
# existing bounded output budget without raising token limits or retrying.
CONUO_MODEL_THINKING_MODE=

# Server-only Supabase secret is required for the model request/quota ledger.
# Use the existing project's secret key, never a NEXT_PUBLIC_* variable.
# For a legacy project, use SUPABASE_SERVICE_ROLE_KEY instead. Do not set both.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Apply the request-ledger and path-specific migrations before enabling generation.
# Durable background organization needs its separate queue migration and scheduler.
# See docs/MODEL_SETUP.md for the current deployed and pending boundaries.
# Per-account request reservations per UTC day (integer 1..500).
CONUO_AI_DAILY_REQUEST_LIMIT=50

# Optional semantic indexing. Server-only, no default provider/model.
# The selected embedding model must return exactly 1536 float dimensions.
CONUO_EMBEDDING_BASE_URL=
CONUO_EMBEDDING_API_KEY=
CONUO_EMBEDDING_MODEL=
# Per-account Unicode characters reserved per UTC day, including failures.
CONUO_EMBEDDING_DAILY_CHAR_LIMIT=200000
# Independent worker credential (minimum 32 visible ASCII characters).
# Configure the same secret on the web server and your trusted processor.
CONUO_PROCESSOR_SECRET=

# Browser-visible deployment declaration for source/knowledge organization jobs.
# Set this to true only after the organization-jobs migration, protected
# processor endpoint, and trusted scheduler are all deployed. It does not
# start a worker or prove that a queued job is healthy; rebuild the web app
# after changing it because NEXT_PUBLIC_* values are embedded at build time.
NEXT_PUBLIC_CONUO_ORGANIZATION_PROCESSOR_ENABLED=false

# Development-only manual fallback for source/knowledge organization. It is
# honored only by `next dev` (NODE_ENV=development), and production builds
# always disable it even if this is true. It does not start a worker or enable
# automatic analysis: each request must be manually started and stops when the
# page is refreshed, closed, or left.
NEXT_PUBLIC_CONUO_LOCAL_ORGANIZATION_RUNNER_ENABLED=false

# Optional source-purge and account-deletion cleanup workers. Each endpoint only accepts
# this dedicated secret (or Vercel CRON_SECRET) and uses the server-only Supabase admin key above.
# Minimum 32 visible ASCII characters; never expose it with NEXT_PUBLIC_.
CONUO_CLEANUP_SECRET=
# On Vercel, the root vercel.json daily cron may use this same value automatically.
# CRON_SECRET=
