{
  "name": "conuo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @conuo/web",
    "build": "npm run build --workspace @conuo/web",
    "start": "npm run start --workspace @conuo/web",
    "lint": "npm run lint --workspace @conuo/web",
    "typecheck": "npm run typecheck --workspace @conuo/web",
    "test": "npm run test --workspace @conuo/web",
    "desktop:dev": "npm run dev --workspace @conuo/desktop",
    "desktop:build": "npm run build --workspace @conuo/desktop",
    "mobile:dev": "npm run start --workspace @conuo/mobile",
    "mobile:preview": "npm run preview --workspace @conuo/mobile",
    "clients:typecheck": "npm run typecheck --workspace @conuo/desktop && npm run typecheck --workspace @conuo/mobile",
    "clients:test": "npm run test --workspace @conuo/desktop && npm run test --workspace @conuo/mobile"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
